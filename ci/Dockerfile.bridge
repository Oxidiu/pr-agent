FROM python:3.12-slim

WORKDIR /app

# Copiem fișierele necesare pentru instalarea pr-agent
COPY requirements.txt .
COPY pyproject.toml .
COPY pr_agent/ pr_agent/
COPY ci/bitbucket_webhook_bridge.py .

# Instalăm pr-agent și dependințele de webhook (FastAPI + Uvicorn)
RUN pip install --no-cache-dir . fastapi uvicorn

# Ne asigurăm că variabila de mediu Python știe unde e codul
ENV PYTHONPATH=/app

CMD ["python", "bitbucket_webhook_bridge.py"]
